# Copia este fichero como .env y rellena tus credenciales.
# NUNCA subas el .env real a git.

# Embeddings + rerank (NAN: https://api.nan.builders)
NAN_BASE_URL=https://api.nan.builders/v1
NAN_API_KEY=tu-api-key-de-nan

# LLM (cualquier endpoint OpenAI-compatible, p.ej. un proxy LiteLLM propio)
LITELLM_BASE_URL=https://tu-proxy-litellm/v1
LITELLM_API_KEY=tu-api-key

# Vector store (Postgres + extensión pgvector)
PG_HOST=ip-o-host-de-tu-postgres
PG_PORT=5432
PG_DB=dragonball
PG_USER=dragonball
PG_PASSWORD=contrasena-del-usuario

# Dimensión de los embeddings (truncado matryoshka de qwen3-embedding:
# 4096 nativo → 1024 para poder indexar con HNSW, que admite ≤2000 dims)
EMBEDDINGS_DIM=1024
